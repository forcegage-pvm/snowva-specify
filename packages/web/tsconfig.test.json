{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedModules": false,
    "types": ["jest", "@testing-library/jest-dom", "@types/jest", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "tests/**/*",
    "__tests__/**/*",
    "jest.setup.js"
  ],
  "exclude": ["node_modules", "cypress/**/*"]
}
