    "loading": {
      "skeletonCount": 8,
      "showGlobalSpinner": false
    },
    "empty": {
      "title": "No customers match your filters",
      "body": "Adjust filters or clear search to view all accounts.",
      "cta": {
        "label": "Clear filters",
        "action": "dispatch('customerDirectory/clearFilters')"
      }
    },
    "error": {
      "title": "We could not load customer data",
      "supporting": "Retry in a few seconds or contact operations support if the issue persists.",
      "retryAction": "dispatch('customerDirectory/retryFetch')"
    }
  },
  "performance": {
    "initialLoadBudgetMs": 2000,
    "subsequentPageBudgetMs": 1200,
    "maxPageSize": 50
  },
  "notes": [
    "Branch list must support virtualization for >40 items per parent.",
    "Outstanding balances must reconcile with statements API within ±0.5%.",
    "All monetary amounts are represented in cents to avoid rounding drift."
  ]
}
