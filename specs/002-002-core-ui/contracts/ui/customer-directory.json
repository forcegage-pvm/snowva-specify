{
  "title": "Customer Directory UI Contract",
  "version": "0.1.0",
  "updated": "2025-09-24",
  "summary": "Shapes the payloads required to render the parent-company directory, branch tree, and linked document context for operations staff.",
  "requests": {
    "listCustomers": {
      "description": "Fetches paginated parent-company listings with aggregate balances and SLA-compliant metadata.",
      "query": {
        "search": "string | null",
        "page": "number",
        "pageSize": "number",
        "sort": "'name' | 'outstandingBalance' | 'creditTerms'",
        "filters": {
          "type": "object",
          "properties": {
            "customerType": "'retail' | 'consumer' | 'mixed' | null",
            "status": "'active' | 'inactive' | null",
            "overdueOnly": "boolean"
          }
        }
      }
    },
    "getCustomerWorkspace": {
      "description": "Returns the full workspace payload for a selected parent company, including branches, contacts, documents, and audit timelines.",
      "params": {
        "customerId": "string"
      }
    }
  },
