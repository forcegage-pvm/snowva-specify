{
  "title": "Documents Workspace UI Contract",
  "version": "0.1.0",
  "updated": "2025-09-26",
  "summary": "Defines the data contracts powering the /documents workspace: export history table, filters, preview modal, and public share link workflow.",
  "requests": {
    "listDocumentExports": {
      "description": "Fetches paginated export history constrained to the last 365 days with combined filters applied.",
      "query": {
        "search": "string | null (matches title, documentId, branch name)",
        "page": "number (>=1)",
        "pageSize": "number (10-100, default 25)",
        "sort": "'createdAt' | 'status' | 'title' | 'lastDownloadedAt'",
        "filters": {
          "type": "object",
          "properties": {
            "documentTypes": "array<'statement'|'invoice'|'quote'|'compliance'>",
            "statuses": "array<'queued'|'sent'|'failed'|'expired'>",
            "channels": "array<'email'|'portal'|'manual'>"
          }
        }
      }
    },
    "getDocumentExport": {
      "description": "Returns full detail for a single export, including preview asset metadata and audit trail snapshot.",
      "params": {
        "exportId": "string"
      }
    },
    "postResendExport": {
      "description": "Triggers resend/regeneration for failed or expired exports and returns updated status.",
      "method": "POST",
      "params": {
        "exportId": "string"
      }
    },
    "postShareLink": {
      "description": "Creates or refreshes a public share link signed token valid for 30 days.",
      "method": "POST",
      "params": {
        "exportId": "string"
      }
    },
    "getAuditTrail": {
      "description": "Returns paginated audit events for a document export.",
      "params": {
        "exportId": "string"
      },
      "query": {
        "cursor": "string | null",
        "limit": "number (default 20)"
      }
    }
  },
