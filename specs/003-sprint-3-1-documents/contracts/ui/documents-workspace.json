  "uiStates": {
    "loading": {
      "skeletonRows": 12,
      "showFilterSkeleton": true
    },
    "empty": {
      "title": "No document exports found",
      "body": "Try adjusting your filters or clearing the search term.",
      "supportingCta": {
        "label": "Clear filters",
        "action": "dispatch('documents/clearFilters')"
      }
    },
    "error": {
      "title": "We couldn't load export history",
      "supporting": "Retry shortly or contact support if the issue persists.",
      "retryAction": "dispatch('documents/retryFetch')"
    },
    "archived": {
      "title": "Looking for older documents?",
      "body": "Exports older than one year are archived. Submit a retrieval request and we'll notify you when it's ready.",
      "cta": {
        "label": "Request archive retrieval",
        "href": "/support/document-archive-request"
      }
    }
  },
  "performance": {
    "initialLoadBudgetMs": 2000,
    "filterResponseBudgetMs": 300,
    "virtualizationThreshold": 100,
    "maxDailyExports": 50,
    "retentionDays": 365
  },
  "notes": [
    "Public share links expire after 30 days and must be regenerated thereafter.",
    "Every preview/download/share action must append to the audit trail and emit telemetry via performanceMetrics.",
    "Virtualization layer must preserve keyboard navigation and screen reader ordering.",
    "Status chips reuse existing design tokens from statements workspace."
  ]
}
