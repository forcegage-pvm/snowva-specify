#!/bin/sh

# Git Pre-Commit Hook - Evidence Fabrication Prevention
# This hook prevents commits containing fabricated evidence files
# 
# CONSTITUTIONAL ENFORCEMENT: Git-level hard stop for evidence fabrication

echo "🔍 Checking evidence files for fabrication..."


# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track results
fabrication_detected=0
evidence_files_checked=0

# Check all staged evidence files
for file in $(git diff --cached --name-only | grep -E "evidence/.*\.(json|log|md)$"); do
  if [ -f "$file" ]; then
    evidence_files_checked=$((evidence_files_checked + 1))
    echo "   Validating: $file"
    
    # Run the evidence fabrication detector using helper script
    validation_result=$(node .specify/tools/validate-evidence-file.js "$file" 2>/dev/null)
    
    if echo "$validation_result" | grep -q "^VALID$"; then
      echo -e "   ${GREEN}✅ $file - authentic${NC}"
    else
      echo -e "   ${RED}❌ $file - FABRICATION DETECTED${NC}"
      fabrication_detected=$((fabrication_detected + 1))
      
      # Show specific violations
      echo -e "   ${YELLOW}📋 Violations found:${NC}"
      echo "$validation_result" | grep "VIOLATION:" | sed 's/VIOLATION:/   • /'
    fi
  fi
done

# Summary
echo ""
echo "📊 Evidence Validation Summary:"
echo "   Files checked: $evidence_files_checked"

if [ $fabrication_detected -gt 0 ]; then
  echo -e "   ${RED}Fabrications detected: $fabrication_detected${NC}"
  echo ""
  echo -e "${RED}🚫 COMMIT BLOCKED - Evidence fabrication detected${NC}"
  echo ""
  echo "📋 REQUIRED ACTIONS:"
  echo "   1. Delete all fabricated evidence files"
  echo "   2. Use actual tools to generate authentic evidence"
  echo "   3. Re-stage only authentic evidence files"
  echo "   4. Retry commit"
  echo ""
  echo "⚖️  CONSTITUTIONAL VIOLATION: Amendment 4 - Anti-Fraud Enforcement"
  echo "   Fabricated evidence violates constitutional compliance"
  echo ""
  echo "💡 HELP:"
  echo "   - Use: mcp_chrome-devtoo_take_screenshot() for browser evidence"
  echo "   - Use: npm test for test results evidence"  
  echo "   - Use: git log for git history evidence"
  echo "   - Save raw, unmodified tool outputs only"
  
  exit 1
else
  if [ $evidence_files_checked -gt 0 ]; then
    echo -e "   ${GREEN}Fabrications detected: 0${NC}"
    echo ""
    echo -e "${GREEN}✅ COMMIT APPROVED - All evidence files are authentic${NC}"
  else
    echo "   No evidence files to validate"
    echo ""
    echo -e "${GREEN}✅ COMMIT APPROVED - No evidence files in this commit${NC}"
  fi
fi

echo ""